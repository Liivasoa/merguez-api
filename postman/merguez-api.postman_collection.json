        {
          "name": "Manches",
          "item": [
            {
              "name": "Créer une manche",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 201 Created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "if (pm.response.code === 201) {",
                      "    const round = pm.response.json();",
                      "    pm.test('Round contains the requested combat', function () {",
                      "        pm.expect(round.number).to.be.a('number').and.above(0);",
                      "        pm.expect(round.combats).to.have.lengthOf(1);",
                      "        pm.expect(round.combats[0].participantIds).to.deep.equal([pm.variables.get('creatorId'), pm.variables.get('participantId')]);",
                      "    });",
                      "    if (Number.isInteger(round.number) && round.number > 0) {",
                      "        pm.collectionVariables.set('roundNumber', round.number);",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requesterId\": \"{{creatorId}}\",\n  \"combats\": [\n    {\n      \"participantIds\": [\"{{creatorId}}\", \"{{participantId}}\"]\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/rounds",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "groups", "{{groupId}}", "rounds"]
                }
              }
            }
          ]
        },
        {
          "name": "Combats",
          "item": [
            {
              "name": "Ajouter un combat à une manche",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200 OK', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "if (pm.response.code === 200) {",
                      "    pm.test('Round contains both combats', function () {",
                      "        const round = pm.response.json();",
                      "        pm.expect(round.number).to.equal(Number(pm.variables.get('roundNumber')));",
                      "        pm.expect(round.combats).to.have.lengthOf(2);",
                      "        pm.expect(round.combats[1].participantIds).to.deep.equal([pm.variables.get('participant2Id'), pm.variables.get('participant3Id')]);",
                      "    });",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requesterId\": \"{{creatorId}}\",\n  \"participantIds\": [\"{{participant2Id}}\", \"{{participant3Id}}\"]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/rounds/{{roundNumber}}/combats",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "groups", "{{groupId}}", "rounds", "{{roundNumber}}", "combats"]
                }
              }
            },
            {
              "name": "Clôturer une manche",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200 OK', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.test('Round is closed with the submitted results', function () {",
                      "    const round = pm.response.json();",
                      "    pm.expect(round.number).to.equal(Number(pm.variables.get('roundNumber')));",
                      "    pm.expect(round.status).to.equal('CLOSED');",
                      "    pm.expect(round.combats).to.have.lengthOf(2);",
                      "    pm.expect(round.combats[0].winnerId).to.equal(pm.variables.get('creatorId'));",
                      "    pm.expect(round.combats[1].winnerId).to.equal(pm.variables.get('participant3Id'));",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requesterId\": \"{{creatorId}}\",\n  \"combats\": [\n    {\"participantIds\": [\"{{creatorId}}\", \"{{participantId}}\"], \"winnerId\": \"{{creatorId}}\"},\n    {\"participantIds\": [\"{{participant2Id}}\", \"{{participant3Id}}\"], \"winnerId\": \"{{participant3Id}}\"}\n  ]\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/rounds/{{roundNumber}}/close",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "groups", "{{groupId}}", "rounds", "{{roundNumber}}", "close"]
                }
              }
            },
            {
              "name": "Clôturer une session",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200 OK', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Session closure returns scores and payments', function () {",
                      "    const result = pm.response.json();",
                      "    pm.expect(result.occurrence.groupId).to.equal(pm.variables.get('groupId'));",
                      "    pm.expect(result.occurrence.scheduleId).to.equal(pm.variables.get('sessionId'));",
                      "    pm.expect(result.occurrence.startedAt).to.be.a('string').and.not.empty;",
                      "    pm.expect(result.netScores).to.be.an('object');",
                      "    pm.expect(result.payments).to.be.an('array');",
                      "    result.payments.forEach(function (payment) {",
                      "        pm.expect(payment.debtorId).to.be.a('string').and.not.empty;",
                      "        pm.expect(payment.creditorId).to.be.a('string').and.not.empty;",
                      "        pm.expect(payment.amount).to.be.a('number').and.above(0);",
                      "    });",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"requesterId\": \"{{participantId}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/sessions/{{sessionId}}/close",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "groups", "{{groupId}}", "sessions", "{{sessionId}}", "close"]
                }
              }
            }
          ]
        }
