        {
          "name": "Créer un groupe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Location header is set', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const group = pm.response.json();",
                  "    pm.test('Group ID is present', function () {",
                  "        pm.expect(group.id).to.be.a('string').and.not.empty;",
                  "    });",
                  "    if (typeof group.id === 'string' && group.id.length > 0) {",
                  "        pm.collectionVariables.set('groupId', group.id);",
                  "        pm.collectionVariables.unset('sessionId');",
                  "        pm.collectionVariables.unset('roundNumber');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
