            },
            {
              "name": "Lister les sessions du groupe",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status is 200 OK', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('Sessions belong to the requested group', function () {",
                      "    const sessions = pm.response.json();",
                      "    pm.expect(sessions).to.be.an('array');",
                      "    sessions.forEach(function (session) {",
                      "        pm.expect(session.groupId).to.equal(pm.variables.get('groupId'));",
                      "        pm.expect(session.id).to.be.a('string').and.not.empty;",
                      "        pm.expect(session.name).to.be.a('string').and.not.empty;",
                      "        pm.expect(session.day).to.be.a('string');",
                      "        pm.expect(session.startTime).to.be.a('string');",
                      "    });",
                      "    const sessionToStart = sessions.find(function (session) {",
                      "        return session.name === 'Evening training';",
                      "    });",
                      "    pm.expect(sessionToStart, 'Evening training session').to.exist;",
                      "    if (sessionToStart && typeof sessionToStart.id === 'string') {",
                      "        pm.collectionVariables.set('sessionId', sessionToStart.id);",
                      "    }",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/sessions",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "groups", "{{groupId}}", "sessions"]
                }
              }
            },
