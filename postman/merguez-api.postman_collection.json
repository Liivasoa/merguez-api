                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/sessions",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "groups", "{{groupId}}", "sessions"]
                }
